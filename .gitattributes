# 统一换行符：Shell/源码/补丁必须 LF，否则 Linux 下会 bad interpreter / 补丁应用失败
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.patch   text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
LICENSE   text eol=lf
.gitignore text eol=lf
*.fragment text eol=lf

# Windows 脚本保留 CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制
*.img     binary
*.gz      binary
*.apk     binary
*.zip     binary
