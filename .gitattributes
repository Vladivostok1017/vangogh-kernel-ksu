# 统一换行符：Shell/源码/补丁必须 LF，否则 Linux 下会 bad interpreter / 补丁应用失败
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.patch   text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
LICENSE   text eol=lf
.gitignore text eol=lf
*.fragment text eol=lf

# Windows 脚本保留 CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制：禁止任何换行符转换，否则 sha256 会变、镜像刷不进去
*.img     binary
*.img.xz  binary
*.gz      binary
*.xz      binary
*.apk     binary
*.zip     binary
*.ko      binary
*.elf     binary
*.bin     binary

# 大体积压缩产物标记为不可合并、不可 diff（仓库自带 ~190 MiB 产物）
artifacts/** -merge -diff
backup/**    -merge -diff

